generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
 
  USER
  SUPER_ADMIN

  @@map("user_role")
}

enum ProjectStatus {
  DRAFT
  PUBLISHED
  FUNDING
  FUNDED
  ACTIVE
  PAUSED
  COMPLETED

  @@map("project_status")
}

enum InvestmentStatus {
  ACTIVE
  MATURED
  CANCELLED
  REFUNDED

  @@map("investment_status")
}

enum TransactionType {
  DEPOSIT
  INVESTMENT
  PRINCIPAL_RETURN
  PROFIT
  WITHDRAWAL
  REFERRAL_REWARD
  REFUND
  ADMIN_ADJUSTMENT

  @@map("tx_type")
}

enum DepositStatus {
  PENDING
  CONFIRMED
  FAILED
  CANCELLED

  @@map("deposit_status")
}

enum WithdrawalStatus {
  PENDING
  PROCESSING
  COMPLETED
  REJECTED
  CANCELLED

  @@map("withdrawal_status")

}

model User {
  id String @id @db.Uuid
  email String? @unique
  fullName String? @map("full_name")
  phone String?
  role Role @default(USER)
  referralCode String? @unique @map("referral_code")
  referredById String? @db.Uuid @map("referred_by")
  isActive Boolean @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @map("updated_at")
  referredBy User? @relation("ReferralTree", fields:[referredById], references:[id])
  referrals User[] @relation("ReferralTree")
  wallet Wallet?
  investments Investment[]
  transactions Transaction[]
  deposits Deposit[]
  withdrawals Withdrawal[]
  notifications Notification[]
  auditLogs AuditLog[]
  referralsAsReferrer Referral[] @relation("Referrer")
  referralsAsReferred Referral? @relation("Referred")
  @@map("profiles")
}

model Project {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title String
  slug String @unique
  description String?
  category String @default("REAL_ESTATE")
  coverUrl String? @map("cover_url")
  galleryUrls String[] @default([]) @map("gallery_urls")
  targetAmount Decimal @db.Decimal(18,2) @map("target_amount")
  raisedAmount Decimal @default(0) @db.Decimal(18,2) @map("raised_amount")
  minInvestment Decimal @default(100) @db.Decimal(18,2) @map("min_investment")
  expectedReturnPct Decimal @db.Decimal(18,4) @map("expected_return_pct")
  returnPlans Json @default("[]") @map("return_plans")
  durationDays Int @map("duration_days")
  status ProjectStatus @default(DRAFT)
  publishedAt DateTime? @map("published_at")
  startsAt DateTime? @map("starts_at")
  endsAt DateTime? @map("ends_at")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @map("updated_at")
  investments Investment[]
  updates ProjectUpdate[]
  @@map("projects")
}

model Wallet {
  userId String @id @db.Uuid @map("user_id")
  balance Decimal @default(0) @db.Decimal(18,2)
  lockedBalance Decimal @default(0) @db.Decimal(18,2) @map("locked_balance")
  updatedAt DateTime @default(now()) @map("updated_at")
  user User @relation(fields:[userId], references:[id])
  @@map("wallets")
}

model Transaction {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId String @db.Uuid @map("user_id")
  type TransactionType
  amount Decimal @db.Decimal(18,2)
  balanceAfter Decimal? @db.Decimal(18,2) @map("balance_after")
  reference String? @unique
  metadata Json @default("{}")
  createdAt DateTime @default(now()) @map("created_at")
  user User @relation(fields:[userId], references:[id])
  @@index([userId,createdAt])
  @@map("transactions")
}

model Deposit {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId String @db.Uuid @map("user_id")
  amount Decimal @db.Decimal(18,2)
  provider String @default("paydunya")
  providerReference String? @unique @map("provider_reference")
  status DepositStatus @default(PENDING)
  metadata Json @default("{}")
  createdAt DateTime @default(now()) @map("created_at")
  confirmedAt DateTime? @map("confirmed_at")
  user User @relation(fields:[userId], references:[id])
  @@index([userId,createdAt])
  @@map("deposits")
}

model Investment {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId String @db.Uuid @map("user_id")
  projectId String @db.Uuid @map("project_id")
  amount Decimal @db.Decimal(18,2)
  expectedProfit Decimal @default(0) @db.Decimal(18,2) @map("expected_profit")
  dailyProfit Decimal @default(0) @db.Decimal(18,2) @map("daily_profit")
  durationDays Int @default(0) @map("duration_days")
  paidDays Int @default(0) @map("paid_days")
  lastProfitAt DateTime? @map("last_profit_at")
  totalReturn Decimal @default(0) @db.Decimal(18,2) @map("total_return")
  status InvestmentStatus @default(ACTIVE)
  investedAt DateTime @default(now()) @map("invested_at")
  maturityAt DateTime @map("maturity_at")
  settledAt DateTime? @map("settled_at")
  settlementReference String? @unique @map("settlement_reference")
  user User @relation(fields:[userId], references:[id])
  project Project @relation(fields:[projectId], references:[id])
  @@index([userId,investedAt])
  @@index([projectId,status])
  @@map("investments")
}

model Withdrawal {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId String @db.Uuid @map("user_id")
  amount Decimal @db.Decimal(18,2)
  fee Decimal @default(0) @db.Decimal(18,2)
  netAmount Decimal? @db.Decimal(18,2) @map("net_amount")
  provider String @default("paydunya")
  providerReference String? @unique @map("provider_reference")
  status WithdrawalStatus @default(PENDING)
  destination Json @default("{}")
  metadata Json @default("{}")
  createdAt DateTime @default(now()) @map("created_at")
  processedAt DateTime? @map("processed_at")
  user User @relation(fields:[userId], references:[id])
  @@index([userId,createdAt])
  @@map("withdrawals")
}

model Referral {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  referrerId String @db.Uuid @map("referrer_id")
  referredUserId String @unique @db.Uuid @map("referred_user_id")
  rewardAmount Decimal @default(0) @db.Decimal(18,2) @map("reward_amount")
  rewardPaid Boolean @default(false) @map("reward_paid")
  referredRewardPaid Boolean @default(false) @map("referred_reward_paid")
  referredRewardedAt DateTime? @map("referred_rewarded_at")
  createdAt DateTime @default(now()) @map("created_at")
  rewardedAt DateTime? @map("rewarded_at")
  referrer User @relation("Referrer",fields:[referrerId],references:[id])
  referredUser User @relation("Referred",fields:[referredUserId],references:[id])
  @@index([referrerId])
  @@map("referrals")
}

model Notification {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId String @db.Uuid @map("user_id")
  title String
  message String
  readAt DateTime? @map("read_at")
  createdAt DateTime @default(now()) @map("created_at")
  user User @relation(fields:[userId],references:[id])
  @@index([userId,createdAt])
  @@map("notifications")
}

model ProjectUpdate {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  projectId String @db.Uuid @map("project_id")
  title String
  content String
  createdAt DateTime @default(now()) @map("created_at")
  project Project @relation(fields:[projectId],references:[id])
  @@index([projectId,createdAt])
  @@map("project_updates")
}

model AuditLog {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  actorId String? @db.Uuid @map("actor_id")
  action String
  entityType String? @map("entity_type")
  entityId String? @db.Uuid @map("entity_id")
  metadata Json @default("{}")
  createdAt DateTime @default(now()) @map("created_at")
  actor User? @relation(fields:[actorId],references:[id])
  @@index([actorId])
  @@map("audit_logs")
}

model Setting {
  key String @id
  value Json
  updatedAt DateTime @default(now()) @map("updated_at")
  @@map("platform_settings")
}
